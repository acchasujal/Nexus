# ==============================================================================
# NEXUS Environment Configuration Template (SIH 2026 PS 26189)
# Copy this file to .env and configure for local or production deployments.
# ==============================================================================

# ── Service Identity ──────────────────────────────────────────────────────────
ENVIRONMENT=development                # development | production
PORT=8000                              # Local default (Render sets this dynamically via $PORT)
AUTH_MODE=demo                         # demo | production_jwt

# ── Security & Authentication ─────────────────────────────────────────────────
# Set to a strong random 32+ character key in production
JWT_SECRET_KEY=nexus-development-secret-key-change-in-production

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (or "*" for development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nexus-frontend.onrender.com

# ── Graph Artifact Storage ────────────────────────────────────────────────────
ARTIFACT_PATH=artifacts/nexus_graph/nexus_graph.json
STATE_PATH=                            # Optional persistent state file path

# ── Persistent Storage (Optional Polyglot Databases) ──────────────────────────
# PostgreSQL Connection URL
DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/nexus_db

# Neo4j Graph Database (Bolt or Neo4j AuraDB: neo4j+s://xxxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexuspassword

# ── Frontend Client Variable (Vite) ───────────────────────────────────────────
# Configured in frontend static hosting (e.g. Render Static Site)
# VITE_API_BASE_URL=https://nexus-backend.onrender.com

