# Local development only. Copy to .env; never commit credentials.
ENVIRONMENT=development
NEXUS_REPOSITORY=memory
# For PostgreSQL: select postgres above and supply a local, private connection URI.
# DATABASE_URL=postgresql://<username>:<url-encoded-password>@127.0.0.1:5432/<database>
DATABASE_URL=
AUTH_MODE=demo
# Empty in development uses an ephemeral per-process key. Production requires a private key.
JWT_SECRET_KEY=
GRAPH_BACKEND=memory
# Required when GRAPH_BACKEND=neo4j. Fill the password privately.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5
NEO4J_QUERY_TIMEOUT=10
# required: abort on connection failure; degraded: start with graph unavailable.
NEO4J_FAILURE_POLICY=required
# Local Docker PostgreSQL only; generate a private URL-safe value.
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
