# ==============================================================================
# NEXUS Environment Configuration Template (SIH 2026 PS 26189)
# Copy this file to .env and configure for local or cloud deployments.
# ==============================================================================

# ==============================================================================
# 1. BACKEND VARIABLES (Set in Render Web Service / Local Backend)
# ==============================================================================

# ── Service Identity ──────────────────────────────────────────────────────────
ENVIRONMENT=production                 # development | production
PORT=8000                              # Local default (Render sets this dynamically via $PORT)
AUTH_MODE=demo                         # demo | production_jwt

# ── Security & Authentication ─────────────────────────────────────────────────
# Set to a strong random 32+ character key in production (Render can generate this)
JWT_SECRET_KEY=nexus-development-secret-key-change-in-production

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g., your Vercel URL and localhost)
CORS_ORIGINS=https://nexus.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ── Graph Artifact Storage ────────────────────────────────────────────────────
ARTIFACT_PATH=artifacts/nexus_graph/nexus_graph.json
STATE_PATH=                            # Optional persistent state file path

# ── Optional Polyglot Databases (Not required for demo / in-memory mode) ──────
# DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/nexus_db
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=nexuspassword

# ==============================================================================
# 2. FRONTEND VARIABLES (Set in Vercel Project Settings)
# ==============================================================================
# Base URL of your deployed FastAPI backend (Build-time variable embedded by Vite)
# VITE_API_BASE_URL=https://nexus-backend.onrender.com


