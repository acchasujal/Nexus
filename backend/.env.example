# NEXUS Criminal Intelligence Platform — Backend Environment Configuration
# Copy this file to .env (in backend/ or repository root) and customize as needed.
# NEVER commit .env with real credentials to source control.

# ── Service Identity ────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins or *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://nexus-eight-weld-33.vercel.app

# ── Repository Backend ──────────────────────────────────────────────────────
# Options: memory (default, zero setup) | postgres / postgresql
NEXUS_REPOSITORY=memory

# Required when NEXUS_REPOSITORY=postgres:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus

# Optional local state persistence path:
# STATE_PATH=artifacts/state/nexus_state.json

# ── Graph Backend & Neo4j ───────────────────────────────────────────────────
# Options: memory (default) | neo4j
GRAPH_BACKEND=memory

# Required when GRAPH_BACKEND=neo4j:
# For Neo4j AuraDB (Cloud): neo4j+s://<dbid>.databases.neo4j.io
# For Local Neo4j:          bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5.0
NEO4J_QUERY_TIMEOUT=10.0
# required (fail startup if unavailable) | degraded (fallback to graceful degradation)
NEO4J_FAILURE_POLICY=degraded

# ── Authentication & Security ───────────────────────────────────────────────
# Options: demo (default, bypasses strict tokens for testing) | production
AUTH_MODE=demo
# Ephemeral auto-generated key used if left empty in development:
JWT_SECRET_KEY=

# ── LLM / AI Copilot Provider ───────────────────────────────────────────────
# NEXUS supports Groq (default), Gemini, OpenAI, or custom OpenAI-compatible endpoints.
# If no key is set, Copilot operates in 100% deterministic rule-based mode.
LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# LLM_API_KEY=...
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
NEXUS_USE_MOCK_LLM=false
